{
  "name": "merlins-castle",
  "version": "2.10.0",
  "description": "A remake of Anita Straker's BBC Micro adventure Merlin's Castle",
  "license": "ISC",
  "author": "Drue Wilding",
  "type": "module",
  "scripts": {
    "art": "node scripts/art.js",
    "art:build": "node scripts/build-art.js",
    "art:status": "node scripts/art.js --list",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gaps": "node scripts/gaps.js",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "models": "node scripts/models.js",
    "preview": "vite preview",
    "sounds": "node scripts/make-sounds.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "tsc --noEmit",
    "world": "cd original && python3 convert.py"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "eslint-config-plus-prettier": "4.3.3",
    "playwright": "^1.64.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "private": true,
  "prettier": "eslint-config-plus-prettier/prettier"
}
